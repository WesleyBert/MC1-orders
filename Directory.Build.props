<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: documentação XML obrigatória só onde fizer sentido (OpenAPI).
         CA1716: alerta sobre palavras reservadas do VB.NET (ex.: Error); projeto é só C#. -->
    <NoWarn>$(NoWarn);CS1591;CA1716</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Código de produção: avisos viram erros. Testes ficam mais flexíveis. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: nomes de teste usam underscore (Metodo_Cenario_Resultado). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
</Project>

{
  "info": {
    "name": "MC1 Orders",
    "description": "Testes da API de pedidos, incluindo todos os erros tratados.\n\nComo usar: suba o projeto (.\\start.cmd ou docker compose up --build) e rode a collection inteira pelo Collection Runner, na ordem. Ela cria os pedidos de que precisa, guarda os ids em variáveis e confere sozinha o código e a mensagem de cada resposta.\n\nSe a API estiver em outro endereço, altere a variável baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "paidOrderId",
      "value": ""
    },
    {
      "key": "deleteOrderId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "    pm.test(\"Erro no formato padrão (application/problem+json)\", () =>",
          "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
          "    pm.test(\"Erro traz traceId para rastrear nos logs\", () =>",
          "        pm.expect(pm.response.json().traceId).to.be.a(\"string\").and.not.empty);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Preparação",
      "description": "Cria os pedidos usados nos testes seguintes e guarda os ids.",
      "item": [
        {
          "name": "Criar pedido Aberto para os testes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 (criado)\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Nasce Aberto, na versão 1\", () => {",
                  "    const order = pm.response.json();",
                  "    pm.expect(order.status).to.eql(\"Open\");",
                  "    pm.expect(order.version).to.eql(1);",
                  "});",
                  "pm.test(\"Devolve ETag e Location\", () => {",
                  "    pm.expect(pm.response.headers.get(\"ETag\")).to.eql('\"1\"');",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/orders/\");",
                  "});",
                  "pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Maria Souza\",\n  \"description\": \"Pedido criado pelo Postman\",\n  \"totalAmount\": 1520.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Criar pedido que será marcado como Pago",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 (criado)\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"paidOrderId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Maria Souza\",\n  \"description\": \"Pedido que será pago\",\n  \"totalAmount\": 1520.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Marcar como Pago",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 (atualizado)\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Agora está Pago\", () => pm.expect(pm.response.json().status).to.eql(\"Paid\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "\"1\""
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{paidOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders",
                "{{paidOrderId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Maria Souza\",\n  \"description\": \"Pedido que será pago\",\n  \"totalAmount\": 1520.5,\n  \"status\": \"Paid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
